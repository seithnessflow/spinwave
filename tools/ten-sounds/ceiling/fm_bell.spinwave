# spinwave preset (TOML)
format = 1
synth_version = "1.0.7"
requires = "vital"

[preset]
name = "ceiling"

[osc_1]
distortion_amount = "60%"
distortion_type = "fm <- osc [8]"

[osc_2]
on = true
level = 0        # -inf dB
transpose = 19
tune = 30

[env_1]
attack = "0 ms"
decay = "3.8416 s"
release = "5.0625 s"
sustain = 0
