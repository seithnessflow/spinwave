# spinwave preset (TOML)
format = 1
synth_version = "1.0.7"
requires = "vital"

[preset]
name = "ceiling"

[osc_1]
wave_frame = 128

[filter_1]
on = true
cutoff = "50 st"   # 146.8 Hz

[[filter_1.mod]]
to = "cutoff"
from = "lfo_1"
amount = "+60%"       # +76.8 st
bipolar = false
rate = "audio"

[lfo_1]
tempo = "2/1"
